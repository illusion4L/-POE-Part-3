@* Sub-navigation for one event in the organiser area. ViewData["Tab"] marks the active tab. *@
@model EventDto
@{
    var tab = ViewData["Tab"] as string;
    string Cls(string t) => "nav-link" + (tab == t ? " active" : "");
}
<ul class="nav event-tabs mb-4" aria-label="Event sections">
    <li class="nav-item"><a class="@Cls("details")" asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@Model.EventId"><i class="bi bi-pencil-square" aria-hidden="true"></i> Details</a></li>
    <li class="nav-item"><a class="@Cls("categories")" asp-controller="Organiser" asp-action="Categories" asp-route-id="@Model.EventId"><i class="bi bi-tags-fill" aria-hidden="true"></i> Categories</a></li>
    <li class="nav-item"><a class="@Cls("enrolments")" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@Model.EventId"><i class="bi bi-people-fill" aria-hidden="true"></i> Enrolments</a></li>
    <li class="nav-item"><a class="@Cls("results")" asp-controller="Organiser" asp-action="Results" asp-route-id="@Model.EventId"><i class="bi bi-stopwatch-fill" aria-hidden="true"></i> Results</a></li>
</ul>
