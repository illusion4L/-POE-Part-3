@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap">
    <div class="panel">
        <h1 class="h2 mb-1">Create your account</h1>
        <p class="text-muted">Join RaceDay to enter events or run your own.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly"></div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">I want to</legend>
                <div class="row g-2">
                    <div class="col-6">
                        <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="role-participant" />
                        <label class="btn btn-outline-navy w-100 py-2" for="role-participant"><i class="bi bi-person-walking" aria-hidden="true"></i> Enter events</label>
                    </div>
                    <div class="col-6">
                        <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="role-organiser" />
                        <label class="btn btn-outline-navy w-100 py-2" for="role-organiser"><i class="bi bi-flag-fill" aria-hidden="true"></i> Organise events</label>
                    </div>
                </div>
                <span asp-validation-for="Role" class="field-validation-error"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="pw-help" />
                <div id="pw-help" class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
        <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
