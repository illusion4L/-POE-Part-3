@model ResultsEntryViewModel
@{
    ViewData["Title"] = "Results · " + Model.Event.Name;
    var ev = Model.Event;
}
<div class="page-header">
    <div>
        <h1>@ev.Name</h1>
        <p>@Fmt.DateTime_(ev.EventDate) · @ev.Location</p>
    </div>
</div>
<partial name="_EventTabs" model="ev" view-data='new ViewDataDictionary(ViewData) { { "Tab", "results" } }' />

@if (Model.HasNotHappenedYet)
{
    <div class="alert alert-warning rd-alert d-flex gap-2" role="status">
        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
        <div>This event hasn't taken place yet. You can enter results after it finishes.</div>
    </div>
}

@if (Model.Enrolments.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-stopwatch" aria-hidden="true"></i>
        <h2 class="h3 mt-2">Nobody to record results for</h2>
        <p class="text-muted mb-0">Results can be entered for participants who are enrolled and not cancelled.</p>
    </div>
}
else
{
    <p class="text-muted">Enter each finish time as <strong>hh:mm:ss</strong> (for example 00:52:31) with the finishing position, then publish. Participants see published results straight away.</p>
    <div class="panel panel-flush">
        <div class="table-responsive">
            <table class="table table-rd">
                <thead><tr><th scope="col">Participant</th><th scope="col">Category</th><th scope="col">Enrolment</th><th scope="col">Finish time</th><th scope="col">Position</th><th scope="col"><span class="visually-hidden">Save</span></th></tr></thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    var formId = $"result-{e.EnrolmentId}";
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>
                            <label class="visually-hidden" for="time-@e.EnrolmentId">Finish time for @e.ParticipantName</label>
                            <input form="@formId" id="time-@e.EnrolmentId" name="FinishTime" class="form-control form-control-sm finish-time" placeholder="00:00:00"
                                   pattern="\d{1,2}:[0-5]\d:[0-5]\d" inputmode="numeric" maxlength="8" required
                                   value="@(e.FinishTime is TimeSpan t ? Fmt.Time(t) : "")" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="pos-@e.EnrolmentId">Finishing position for @e.ParticipantName</label>
                            <input form="@formId" id="pos-@e.EnrolmentId" name="FinishPosition" type="number" min="1" class="form-control form-control-sm" style="max-width:6.5rem" placeholder="e.g. 47"
                                   value="@e.FinishPosition" />
                        </td>
                        <td class="text-end text-nowrap">
                            <form id="@formId" asp-action="SaveResult" asp-route-id="@ev.EventId" method="post" class="d-inline">
                                <input type="hidden" name="EnrolmentId" value="@e.EnrolmentId" />
                                <input type="hidden" name="EventId" value="@ev.EventId" />
                                <input type="hidden" name="IsUpdate" value="@(e.HasResult ? "true" : "false")" />
                                <button type="submit" class="btn btn-sm @(e.HasResult ? "btn-outline-primary" : "btn-primary")">
                                    <i class="bi @(e.HasResult ? "bi-pencil-fill" : "bi-send-fill")" aria-hidden="true"></i> @(e.HasResult ? "Update" : "Publish")
                                </button>
                            </form>
                            @if (e.HasResult) { <span class="status-badge status-confirmed ms-1"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Published</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
