@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
    var asEvent = new EventDto { EventId = Model.EventId ?? 0 };
}
<div class="page-header">
    <div>
        <h1>@(Model.IsEdit ? "Edit event" : "Create event")</h1>
        <p>@(Model.IsEdit ? "Update the details participants see." : "Tell participants what, where and when.")</p>
    </div>
</div>

@if (Model.IsEdit) { <partial name="_EventTabs" model="asEvent" view-data='new ViewDataDictionary(ViewData) { { "Tab", "details" } }' /> }

<form asp-action="@(Model.IsEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel">
                <div asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Event name</label>
                    <input asp-for="Name" class="form-control" maxlength="150" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5" maxlength="4000" aria-describedby="desc-help"></textarea>
                    <div id="desc-help" class="form-text">Route, start area, parking, what to bring.</div>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="EventDate" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" maxlength="150" />
                        <span asp-validation-for="Location" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" class="form-control" type="number" step="0.01" min="0.01" inputmode="decimal" />
                        <span asp-validation-for="Distance" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <fieldset>
                            <legend class="form-label fs-6">Event type</legend>
                            <div class="d-flex gap-2 type-pills">
                                @foreach (var (value, icon) in new[] { ("Run", "bi-lightning-charge-fill"), ("Walk", "bi-person-walking"), ("Cycle", "bi-bicycle") })
                                {
                                    <input type="radio" class="btn-check" name="EventType" value="@value" id="type-@value" checked="@(Model.EventType == value)" />
                                    <label class="btn btn-outline-navy flex-fill" for="type-@value"><i class="bi @icon" aria-hidden="true"></i> @value</label>
                                }
                            </div>
                            <span asp-validation-for="EventType" class="field-validation-error"></span>
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel">
                <h2 class="panel-title">Banner image</h2>

                @if (Model.IsEdit && Model.HasBanner)
                {
                    <img class="banner-preview mb-3" src="@Url.Action("Banner", "Events", new { id = Model.EventId })" alt="Current banner" />
                    <div class="form-check mb-3">
                        <input asp-for="RemoveBanner" class="form-check-input" />
                        <label asp-for="RemoveBanner" class="form-check-label">Remove the current banner</label>
                    </div>
                }
                <img id="banner-preview" class="banner-preview mb-3 d-none" alt="Preview of the chosen banner" />

                <label asp-for="BannerFile" class="form-label">@(Model.HasBanner ? "Replace banner" : "Upload a banner")</label>
                <input asp-for="BannerFile" class="form-control" type="file" accept="image/jpeg,image/png,image/gif,image/webp" data-preview="#banner-preview" aria-describedby="banner-help" />
                <div id="banner-help" class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. Wide images (about 21:9) look best.</div>
                <span asp-validation-for="BannerFile" class="field-validation-error"></span>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
