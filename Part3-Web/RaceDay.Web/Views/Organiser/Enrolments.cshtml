@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments · " + Model.Event.Name;
    var ev = Model.Event;
    int Count(string s) => Model.AllEnrolments.Count(e => e.Status == s);
}
<div class="page-header">
    <div>
        <h1>@ev.Name</h1>
        <p>@Fmt.DateTime_(ev.EventDate) · @ev.Location</p>
    </div>
</div>
<partial name="_EventTabs" model="ev" view-data='new ViewDataDictionary(ViewData) { { "Tab", "enrolments" } }' />

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <span class="fw-semibold me-1">@Model.AllEnrolments.Count enrolled</span>
    <partial name="_StatusBadge" model="@("Confirmed")" /> <span class="text-muted me-2">@Count("Confirmed")</span>
    <partial name="_StatusBadge" model="@("Pending")" /> <span class="text-muted me-2">@Count("Pending")</span>
    <partial name="_StatusBadge" model="@("Cancelled")" /> <span class="text-muted">@Count("Cancelled")</span>
</div>

<form method="get" asp-action="Enrolments" asp-route-id="@ev.EventId" class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-md-3">
        <label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status">
            <option value="">All statuses</option>
            @foreach (var s in new[] { "Pending", "Confirmed", "Cancelled" })
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-sm-4 col-md-3">
        <label class="form-label" for="categoryId">Category</label>
        <select class="form-select" id="categoryId" name="categoryId">
            <option value="">All categories</option>
            @foreach (var c in ev.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-navy">Filter</button>
        @if (Model.Status is not null || Model.CategoryId is not null) { <a class="btn btn-outline-secondary" asp-action="Enrolments" asp-route-id="@ev.EventId">Clear</a> }
    </div>
</form>

@if (Model.Enrolments.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-people" aria-hidden="true"></i>
        <h2 class="h3 mt-2">@(Model.AllEnrolments.Count == 0 ? "Nobody has enrolled yet" : "No enrolments match those filters")</h2>
        <p class="text-muted mb-0">@(Model.AllEnrolments.Count == 0 ? "Participants appear here as soon as they enrol." : "Clear the filters to see everyone.")</p>
    </div>
}
else
{
    <div class="panel panel-flush">
        <div class="table-responsive">
            <table class="table table-rd">
                <thead><tr><th scope="col">Participant</th><th scope="col">Category</th><th scope="col">Enrolled on</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Change status</span></th></tr></thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@Fmt.Date(e.EnrolmentDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            <form asp-action="SetStatus" asp-route-id="@ev.EventId" asp-route-enrolmentId="@e.EnrolmentId" method="post" class="d-inline-flex gap-1">
                                @if (e.Status != "Confirmed") { <button type="submit" name="status" value="Confirmed" class="btn btn-sm btn-outline-success">Confirm</button> }
                                @if (e.Status != "Pending") { <button type="submit" name="status" value="Pending" class="btn btn-sm btn-outline-secondary">Set pending</button> }
                                @if (e.Status != "Cancelled") { <button type="submit" name="status" value="Cancelled" class="btn btn-sm btn-outline-danger">Cancel</button> }
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
