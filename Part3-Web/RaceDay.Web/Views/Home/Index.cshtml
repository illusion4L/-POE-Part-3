@model EventListViewModel
@{
    ViewData["Title"] = "Upcoming events";
    ViewData["FullBleed"] = true;
    var user = Context.Session.GetUser();
}

<section class="rd-hero">
    <div class="container">
        <h1>Find your next start line</h1>
        <p class="lead">Runs, walks and rides across the country. Pick an event, choose your category and get on the list.</p>
        @if (user is null)
        {
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            </div>
        }
    </div>
</section>
<div class="rd-hero-stripe" aria-hidden="true"></div>

<div class="container pb-4">
    <form method="get" asp-controller="Home" asp-action="Index" class="filter-bar" role="search" aria-label="Filter events">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="location">Location</label>
                <input class="form-control" id="location" name="location" value="@Model.Location" placeholder="Town or venue" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label" for="eventType">Event type</label>
                <select class="form-select" id="eventType" name="eventType">
                    <option value="">All types</option>
                    @foreach (var type in new[] { "Run", "Walk", "Cycle" })
                    {
                        <option value="@type" selected="@(Model.EventType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label" for="date">On date</label>
                <input class="form-control" type="date" id="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Apply filters</button>
                @if (Model.IsFiltered)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </div>
        </div>
    </form>

    <partial name="_Alerts" />

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h2 class="mb-0">@(Model.IsFiltered ? "Matching events" : "Upcoming events")</h2>
        <span class="text-muted" aria-live="polite">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events")</span>
    </div>

    @if (Model.Events.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-flag" aria-hidden="true"></i>
            <h3 class="mt-2">@(Model.IsFiltered ? "No events match those filters" : "No upcoming events yet")</h3>
            <p class="text-muted mb-3">@(Model.IsFiltered ? "Try a different location, type or date." : "Check back soon - organisers add new events all the time.")</p>
            @if (Model.IsFiltered) { <a class="btn btn-primary" asp-action="Index">Show all events</a> }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model.Events)
            {
                <div class="col-sm-6 col-lg-4"><partial name="_EventCard" model="ev" /></div>
            }
        </div>
    }
</div>
